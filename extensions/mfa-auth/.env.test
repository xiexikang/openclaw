# MFA Auth 插件测试配置
# 请复制此文件到你的 OpenClaw 配置目录，并填入真实的 Dabby 凭证

# --- 基础配置 ---
# 启用调试日志
MFA_DEBUG=true

# --- 后端轮询配置（分离式部署模式）---
# 启用后端自动轮询（分离式部署必须启用）
MFA_ENABLE_BACKEND_POLLING=true

# 外网认证页面 URL（可选，用于分离式部署）
# 示例：https://auth.example.com/auth/auth.html
# 如果不设置，将使用本地 HTTP 服务器
# MFA_AUTH_PAGE_URL=

# --- Dabby (大白) 实名认证账号（必填）---
# 请在 https://www.dabby.com/ 注册并获取
DABBY_CLIENT_ID=b76237dd43dc122d
DABBY_CLIENT_SECRET=9b1e2caa-f086-44d7-b1bc-924c4733c248

# --- 敏感操作关键词 ---
MFA_SENSITIVE_KEYWORDS=delete,remove,rm,unlink,rmdir,format,wipe,erase,exec,eval,system,shell,bash,sudo,su,chmod,chown,restart,shutdown,reboot,gateway,kill,stop,drop,truncate

# --- 首次认证配置 ---
MFA_REQUIRE_AUTH_ON_FIRST_MESSAGE=true
MFA_FIRST_MESSAGE_AUTH_DURATION=86400000

# --- 二次认证配置 ---s
MFA_REQUIRE_AUTH_ON_SENSITIVE_OPERATION=true
MFA_VERIFICATION_DURATION=120000

# --- 存储路径 ---
MFA_AUTH_STATE_DIR=~/.openclaw/mfa-auth/

# --- 飞书配置（如需飞书通知）---
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# --- 网关配置（用于 Web 聊天通知）---
MFA_GATEWAY_HOST=127.0.0.1
